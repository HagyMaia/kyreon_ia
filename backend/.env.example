APP_NAME="Kyreon AI - Agent Platform"
ENVIRONMENT=development

# Database (SQLite local, Docker PostgreSQL ou Neon Serverless PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./agent_platform.db
# Para PostgreSQL Local/Docker: postgresql+asyncpg://agent:agent@localhost:5432/agentdb
# Para Neon PostgreSQL (Serverless): postgresql://user:password@ep-xyz-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require

# Provedor padrão: "auto" | "openai" | "gemini" | "mock"
DEFAULT_PROVIDER=auto

# OpenAI (Responses API / GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Google Gemini (Gemini 2.0 Flash / Gemini 1.5 Pro)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
