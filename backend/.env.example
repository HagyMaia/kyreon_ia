APP_NAME="Kyreon AI - Agent Platform"
ENVIRONMENT=development

# Database (SQLite padrão para dev local ou PostgreSQL para Docker)
DATABASE_URL=sqlite+aiosqlite:///./agent_platform.db
# Para PostgreSQL: postgresql+asyncpg://agent:agent@localhost:5432/agentdb

# Provedor padrão: "auto" | "openai" | "gemini" | "mock"
DEFAULT_PROVIDER=auto

# OpenAI (Responses API / GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Google Gemini (Gemini 2.0 Flash / Gemini 1.5 Pro)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
